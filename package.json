{
  "name": "mechane",
  "private": true,
  "type": "module",
  "scripts": {
    "dev:studio": "pnpm --filter @mechane/studio dev",
    "dev:player": "pnpm --filter @mechane/player dev",
    "dev:api": "pnpm --filter @mechane/api dev",
    "db:seed": "pnpm --filter @mechane/api db:seed",
    "db:migrate": "pnpm --filter @mechane/api db:migrate",
    "db:push": "pnpm --filter @mechane/api db:push",
    "storybook": "pnpm --filter @mechane/storybook storybook",
    "build-storybook": "pnpm --filter @mechane/storybook build-storybook",
    "build": "pnpm -r build",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "oxlint .",
    "format": "oxfmt .",
    "typecheck": "pnpm -r typecheck",
    "codegen": "pnpm --filter @mechane/graphql-schema codegen",
    "react-doctor": "react-doctor"
  },
  "devDependencies": {
    "graphql-language-service-cli": "^3.5.0",
    "oxfmt": "^0.62.0",
    "oxlint": "^1.77.0",
    "react-doctor": "^0.9.5",
    "typescript": "^7.0.2",
    "typescript-language-server": "^5.3.0",
    "typescript-lsp": "npm:typescript@5.9.3",
    "vitest": "^3.2.0"
  },
  "packageManager": "pnpm@11.5.2"
}
