# Local Postgres started via `docker compose up` at the repo root.
DATABASE_URL=postgres://presence:presence@localhost:5432/presence

# Generate a real secret for anything beyond local dev, e.g. `openssl rand -base64 32`.
BETTER_AUTH_SECRET=dev-only-secret-change-me
BETTER_AUTH_URL=http://localhost:4000

# Origin of apps/studio — the only origin allowed to make credentialed
# requests (CORS) or complete an auth flow (Better Auth's trustedOrigins).
# Defaults to Vite's local dev port if unset.
APP_STUDIO_URL=http://localhost:5173

# Google OAuth client — create one in Google Cloud Console with an
# authorized redirect URI of `${BETTER_AUTH_URL}/api/auth/callback/google`.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
