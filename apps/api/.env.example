# Local Postgres and MinIO started via `docker compose up` at the repo root.
DATABASE_URL=postgres://mechane:mechane@localhost:5433/mechane
BLOB_STORAGE_DRIVER=minio
BLOB_STORAGE_ENDPOINT=http://localhost:9000
BLOB_STORAGE_BUCKET=mechane
BLOB_STORAGE_ACCESS_KEY=minioadmin
BLOB_STORAGE_SECRET_KEY=minioadmin
BLOB_STORAGE_REGION=us-east-1
BLOB_PUBLIC_URL=http://localhost:9000/mechane/blobs

# Generate a real secret for anything beyond local dev, e.g. `openssl rand -base64 32`.
BETTER_AUTH_SECRET=dev-only-secret-change-me
# HTTPS development URLs when the local Caddy proxy is running.
BETTER_AUTH_URL=https://api.mechane.dev

# Local development uses Mailpit. Open http://localhost:8025 to read messages.
SMTP_URL=smtp://localhost:1025
EMAIL_FROM="Mechanē <noreply@localhost>"

# Production uses Resend. Set these only in the deployed API environment.
# RESEND_API_KEY=
# EMAIL_FROM="Mechanē <noreply@send.mechane.live>"

# Email verification is required unless this is exactly "false". Use the
# override only where email delivery is intentionally disabled.
# REQUIRE_EMAIL_VERIFICATION=false

# Browser origins. Studio uses Better Auth; Player uses pairing-code bootstrap.
APP_STUDIO_URL=https://studio.mechane.dev
APP_PLAYER_URL=https://show.mechane.dev

# Direct HTTP fallback when Caddy is not running:
# BETTER_AUTH_URL=http://localhost:4000
# APP_STUDIO_URL=http://localhost:5173
# APP_PLAYER_URL=http://localhost:5174

# Production realtime uses Ably. Local development defaults to the WebSocket adapter.
# REALTIME_PROVIDER=ably
# ABLY_API_KEY=

# Vercel Cron bearer token for the protected Player invalidation drain.
CRON_SECRET=
# Vercel Cron schedule; defaults to daily at 04:00 for Vercel Hobby.
CRON_SCHEDULE=


# Google OAuth client — create one in Google Cloud Console with an
# authorized redirect URI of `${BETTER_AUTH_URL}/api/auth/callback/google`.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
