{
  "name": "@presence/api",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/dev-server.ts",
    "build": "tsc -p tsconfig.json --noEmit",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:seed": "tsx src/db/seed.ts"
  },
  "dependencies": {
    "@presence/domain": "workspace:*",
    "better-auth": "^1.6.26",
    "drizzle-orm": "^0.45.2",
    "graphql": "^17.0.2",
    "graphql-yoga": "^5.21.2",
    "pg": "^8.22.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/pg": "^8.20.4",
    "@vercel/node": "^5.9.5",
    "drizzle-kit": "^0.31.10",
    "tsx": "^4.23.8",
    "typescript": "^5.9.0"
  }
}
