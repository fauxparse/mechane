{
  "name": "@mechane/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/dev-server.ts",
    "build": "tsc -p tsconfig.json --noEmit",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:seed": "tsx src/db/seeds.ts",
    "realtime:worker": "tsx src/realtime-worker.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1111.0",
    "@mechane/commands": "workspace:*",
    "@mechane/domain": "workspace:*",
    "@mechane/realtime": "workspace:*",
    "better-auth": "^1.6.26",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "graphql": "^17.0.2",
    "graphql-yoga": "^5.21.2",
    "pg": "^8.22.0"
  },
  "devDependencies": {
    "@mechane/graphql-schema": "workspace:*",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.20.4",
    "@vercel/node": "^5.9.5",
    "drizzle-kit": "^0.31.10",
    "tsx": "^4.23.8",
    "typescript": "^7.0.2"
  }
}
