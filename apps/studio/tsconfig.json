{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "dist",
    "rootDir": "src",
    "declaration": false,
    "declarationMap": false,
    "paths": {
      "*": ["./*"],
      "@/*": ["./src/*"],
      "@studio/*": ["./src/*"],
      "@show-editor/*": ["./src/editors/show/*"],
      "@canvas-editor/*": ["./src/editors/canvas/*"]
    }
  },
  "include": ["src"]
}
