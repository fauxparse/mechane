# HTTPS development URL through the local Caddy proxy. For direct HTTP,
# override this with http://localhost:4000 when Caddy is not running.
VITE_API_URL=https://api.mechane.dev

# HTTPS development URL for the Player, which the dashboard links out to for
# each of a Show's Devices. Override with http://localhost:5174 for direct
# HTTP, or with a worktree instance's assigned port.
VITE_PLAYER_URL=https://show.mechane.dev

# Google Fonts Webfonts API key used by the Canvas text font picker.
VITE_GOOGLE_FONTS_API_KEY=

# Whether to show the "Continue with Google" button on the sign-in screen.
# Only flip this on once apps/api's GOOGLE_CLIENT_ID/GOOGLE_CLIENT_SECRET
# (apps/api/.env.example) are actually configured — otherwise Google
# sign-in will 404/error against Better Auth.
VITE_GOOGLE_OAUTH_ENABLED=false
