{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "paths": {
      "*": ["./*"],
      "@storybook/react-vite": ["./node_modules/@storybook/react-vite/dist/index.d.ts"],
      "@/*": ["../apps/studio/src/*"],
      "@studio/*": ["../apps/studio/src/*"],
      "@show-editor/*": ["../apps/studio/src/editors/show/*"],
      "@canvas-editor/*": ["../apps/studio/src/editors/canvas/*"]
    }
  },
  "include": [
    ".storybook",
    "../apps/studio/src/vite-env.d.ts",
    "../apps/studio/src/**/*.stories.tsx",
    "../packages/design-system/src/**/*.stories.tsx",
    "../packages/rendering/src/**/*.stories.tsx"
  ]
}
